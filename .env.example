# Groly Konfiguration
# Diese Datei als .env kopieren und anpassen

# Datenbank (Docker Volume wird empfohlen)
DATABASE_URL=/app/data/groly.db

# Admin-User (wird beim ersten Start angelegt, falls keine User vorhanden)
ADMIN_USERNAME=admin
# Beim ersten Start ein eigenes Passwort setzen. Kein Standardpasswort.
ADMIN_PASSWORD=

# In Production auf true setzen (sichere Cookies)
NODE_ENV=production

# Set to true to keep checked-off items in all lists. The default is 60-day cleanup.
KEEP_CHECKED_ITEMS=false

# Web Push (VAPID) - generate keys with `node --input-type=module -e "import { generateVAPIDKeys } from 'web-push'; console.log(generateVAPIDKeys())"`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@groly.local
# Gleicher Wert wie VAPID_PUBLIC_KEY (wird im Browser verwendet)
PUBLIC_VAPID_PUBLIC_KEY=

# Save a copy as .env beside docker-compose.yml on your NAS.
# Keep this file private. Never commit real credentials to Git.

# Credentials for the first administrator. No default password is provided.
ADMIN_USERNAME=admin
# Enter a unique password. Single quotes keep $ and # literal, for example:
# ADMIN_PASSWORD='replace-with-your-own-long-password'
ADMIN_PASSWORD=

# The exact HTTPS address used in your browser, without a path or trailing slash.
ORIGIN=https://groly.example.com

# Local port used by DSM's reverse proxy. Change if port 3000 is already in use.
GROLY_PORT=3000
